NODE_ENV=development
PORT=3004

# Postgres (Neon — same instance as auth-service)
DATABASE_URL=postgresql://...

# Auth service — used to fetch JWKS for RS256 token verification
AUTH_SERVICE_ISSUER=https://auth-service-jet-seven.vercel.app
AUTH_SERVICE_JWKS_URI=https://auth-service-jet-seven.vercel.app/.well-known/jwks.json

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# App
APP_BASE_URL=http://localhost:3004
