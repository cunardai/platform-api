NODE_ENV=development
PORT=3004

# Azure App Service / Key Vault injected secret (preferred)
# In Azure, set this exact app setting and point it to the real Postgres URI.
POSTGRESQLSANDBOXPLATEFORMAPIURI=postgresql://username:password@host:5432/database?sslmode=require

# Legacy local/dev fallback only
DATABASE_URL=postgresql://username:password@localhost:5432/platform

# Auth service — used to fetch JWKS for RS256 token verification
AUTH_SERVICE_ISSUER=https://auth-service-jet-seven.vercel.app
AUTH_SERVICE_JWKS_URI=https://auth-service-jet-seven.vercel.app/.well-known/jwks.json

# Stripe
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBSTRIPESECRETKEY=sk_test_...
# Legacy local/dev fallback only
STRIPE_SECRET_KEY=sk_test_...
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBSTRIPEWEBHOOKSECRET=whsec_...
# Legacy local/dev fallback only
STRIPE_WEBHOOK_SECRET=whsec_...
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBSTRIPEPRICESTARTER=price_...
# Legacy local/dev fallback only
STRIPE_PRICE_STARTER=price_...
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBSTRIPEPRICEPRO=price_...
# Legacy local/dev fallback only
STRIPE_PRICE_PRO=price_...

# App
APP_BASE_URL=http://localhost:3004

# ─── Data protection (ISO 27001 A.8.11 / A.8.24) ───────────────────────────────
# Field-level encryption at rest for mcp_versions.auth_header (AES-256-GCM).
# 64 hex chars = 32 bytes. Generate: `openssl rand -hex 32`
# If unset, encryption is DISABLED (values stored/returned as plaintext — degradable).
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBENCRYPTIONKEY=
# Legacy local/dev fallback only
ENCRYPTION_KEY=

# HMAC key for deterministic pseudonymisation of identifiers in masking utils.
# Any high-entropy secret. Generate: `openssl rand -hex 32`
# If unset, pseudonymize() falls back to a plain SHA-256 hash.
# Azure App Service / Key Vault injected secret (preferred)
PLATEFORMAPISBPSEUDONYMKEY=
# Legacy local/dev fallback only
PSEUDONYM_KEY=
